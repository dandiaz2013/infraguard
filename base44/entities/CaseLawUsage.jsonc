{
  "name": "CaseLawUsage",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string",
      "description": "Matter using the authority"
    },
    "case_law_id": {
      "type": "string",
      "description": "Authority used"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "limitation",
        "recovery",
        "duty",
        "procedure",
        "causation",
        "remedy",
        "standard_of_review",
        "other"
      ],
      "default": "other",
      "description": "What the authority is used for"
    },
    "context_issue_id": {
      "type": "string",
      "description": "Taxonomy issue the authority supports"
    },
    "stance": {
      "type": "string",
      "enum": [
        "supports",
        "against",
        "neutral"
      ],
      "default": "neutral",
      "description": "Whether the authority helps or hurts the position"
    },
    "note": {
      "type": "string",
      "description": "User note"
    }
  },
  "required": [
    "matter_id",
    "case_law_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}