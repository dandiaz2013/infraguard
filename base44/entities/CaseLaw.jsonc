{
  "name": "CaseLaw",
  "type": "object",
  "properties": {
    "neutral_citation": {
      "type": "string",
      "description": "Neutral citation, e.g. [2023] UKSC 12"
    },
    "name": {
      "type": "string",
      "description": "Case name, e.g. Smith v Jones"
    },
    "court": {
      "type": "string",
      "description": "Court that decided the case"
    },
    "year": {
      "type": "number",
      "description": "Year of the decision"
    },
    "report_reference": {
      "type": "string",
      "description": "Law report reference"
    },
    "url": {
      "type": "string",
      "description": "Link to the primary source"
    },
    "official_url": {
      "type": "string",
      "description": "Official page used to check the extracts"
    },
    "summary": {
      "type": "string",
      "description": "Short summary of the decision"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legal principles established"
    },
    "principle_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principle": {
            "type": "string"
          },
          "paragraph_ref": {
            "type": "string"
          }
        }
      },
      "description": "Principles recorded from the judgment, each with its paragraph reference"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Checked against a primary source by a user"
    },
    "is_main": {
      "type": "boolean",
      "default": false,
      "description": "Main authority, carries verbatim paragraph extracts"
    },
    "check_status": {
      "type": "string",
      "enum": [
        "Not checked",
        "Extract checked against official text"
      ],
      "default": "Not checked",
      "description": "Whether the user has compared the stored extracts with the official judgment"
    },
    "checked_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the extracts were compared with the official text"
    },
    "checked_notes": {
      "type": "string",
      "description": "User note recorded when checking the extracts"
    },
    "source_note": {
      "type": "string",
      "description": "Where this record came from"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}