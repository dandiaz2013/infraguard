{
  "name": "IssueApproach",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string",
      "description": "Matter the choice was made for"
    },
    "argument_id": {
      "type": "string",
      "description": "Argument version the choice belongs to"
    },
    "issue_id": {
      "type": "string",
      "description": "Gateway issue id, e.g. route, materiality, promptness"
    },
    "issue_label": {
      "type": "string",
      "description": "Issue title as shown when the choice was saved"
    },
    "approach_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Approaches chosen from the proposed list"
    },
    "own_approach": {
      "type": "string",
      "description": "The user's own approach in their words"
    },
    "explanation": {
      "type": "string",
      "description": "The user's explanation for this issue"
    },
    "source_document": {
      "type": "string",
      "description": "Optional document the explanation points to"
    },
    "source_ref": {
      "type": "string",
      "description": "Optional paragraph or page the explanation points to"
    },
    "evidence_rating": {
      "type": "string",
      "description": "Evidence rating at the time of saving"
    },
    "argument_rating": {
      "type": "string",
      "description": "Argument rating at the time of saving"
    },
    "status": {
      "type": "string",
      "description": "Not addressed / Explained, not evidenced / Evidenced / Evidenced and backed by a checked authority"
    },
    "changes": {
      "type": "array",
      "description": "Before and after for each rating that moved, with the reason",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the choice was saved"
    }
  },
  "required": [
    "matter_id",
    "issue_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}