{
  "name": "Matter",
  "type": "object",
  "properties": {
    "matter_reference": {
      "type": "string",
      "description": "Unique matter reference number"
    },
    "matter_name": {
      "type": "string",
      "description": "Name/title of the matter"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "matter_type": {
      "type": "string",
      "enum": [
        "Civil Litigation",
        "Criminal Defence",
        "Family Law",
        "Employment",
        "Contract Dispute",
        "Judicial Review",
        "Appeal",
        "Other"
      ],
      "description": "Type of legal matter"
    },
    "court": {
      "type": "string",
      "description": "Court or tribunal"
    },
    "our_side": {
      "type": "string",
      "enum": [
        "Claimant",
        "Defendant",
        "Appellant",
        "Respondent",
        "Applicant"
      ],
      "description": "Which side this matter acts for; used to read a document's party from its text"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Hold",
        "Closed",
        "Appeal Pending"
      ],
      "default": "Active"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the matter"
    },
    "key_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "domain_id": {
      "type": "string",
      "description": "Taxonomy domain id"
    },
    "relationship_id": {
      "type": "string",
      "description": "Taxonomy relationship id"
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected taxonomy issue ids"
    },
    "answers": {
      "type": "object",
      "description": "Triage answers keyed by question id (Yes / No / Unsure)"
    },
    "merits_score": {
      "type": "number",
      "description": "Deterministic merits score 0-100"
    },
    "merits_band": {
      "type": "string",
      "description": "Poor / Speculative / Arguable / Strong"
    },
    "score_breakdown": {
      "type": "object",
      "description": "Points per triage question plus the case law adjustment"
    },
    "scored_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the score was last calculated"
    },
    "simple_arguments": {
      "type": "object",
      "description": "Workflow step 2 output: issues and simple arguments for each side, each tied to a document and paragraph"
    },
    "simple_arguments_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the simple arguments were last generated"
    }
  },
  "required": [
    "matter_name",
    "client_name",
    "matter_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}