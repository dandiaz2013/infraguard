{
  "name": "Document",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string",
      "description": "Related matter ID"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Particulars of Claim",
        "Defence",
        "Witness Statement",
        "Skeleton Argument",
        "Appeal Grounds",
        "Case Summary",
        "Legal Opinion",
        "Other"
      ],
      "description": "Type of legal document"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "content": {
      "type": "string",
      "description": "Document content in markdown or HTML"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Review",
        "Final",
        "Filed"
      ],
      "default": "Draft"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the document"
    },
    "record_status": {
      "type": "string",
      "enum": [
        "Filed or served",
        "Draft",
        "Reference only"
      ],
      "default": "Filed or served",
      "description": "Filed or served documents are the record for this matter"
    },
    "filed_date": {
      "type": "string",
      "format": "date",
      "description": "Date filed or served"
    },
    "filed_by": {
      "type": "string",
      "enum": [
        "Ours",
        "Other party",
        "Court"
      ],
      "description": "Who filed or produced the document"
    },
    "exhibit_of": {
      "type": "string",
      "description": "Optional parent document this document is an exhibit to"
    }
  },
  "required": [
    "matter_id",
    "document_type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}