{
  "name": "Argument",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string",
      "description": "Related matter ID"
    },
    "version_number": {
      "type": "number",
      "description": "Version number for this argument",
      "default": 1
    },
    "argument_title": {
      "type": "string",
      "description": "Title of the argument"
    },
    "position": {
      "type": "string",
      "enum": [
        "Claimant",
        "Defendant",
        "Appellant",
        "Respondent"
      ],
      "description": "Which side this argument supports"
    },
    "court": {
      "type": "string",
      "description": "Court locked from Matter"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Jurisdiction locked from Matter"
    },
    "fact_pattern": {
      "type": "string",
      "description": "Saved fact pattern for this version"
    },
    "fact_expansions": {
      "type": "object",
      "properties": {
        "chronology": {
          "type": "string"
        },
        "disputed_facts": {
          "type": "string"
        },
        "undisputed_facts": {
          "type": "string"
        },
        "legal_issues_raised": {
          "type": "string"
        },
        "procedural_history": {
          "type": "string"
        },
        "loss_harm_risk": {
          "type": "string"
        }
      },
      "description": "Fact pattern expansions"
    },
    "argument_text": {
      "type": "string",
      "description": "Full argument markdown text"
    },
    "legal_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identified legal issues"
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Authority IDs supporting this argument"
    },
    "practice_directions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Applied Practice Directions"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Final"
      ],
      "default": "Draft",
      "description": "Argument status"
    },
    "parent_version_id": {
      "type": "string",
      "description": "ID of previous version if this is a revision"
    },
    "our_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "paragraph_ref": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "added_date": {
            "type": "string"
          }
        }
      },
      "description": "Our points, each with an optional document and paragraph reference"
    },
    "contract_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        }
      },
      "description": "Contract clauses or rules relied on, with whether the wording has been checked"
    },
    "misstatements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "correct_position": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "paragraph_ref": {
            "type": "string"
          }
        }
      },
      "description": "Statements by the other side that our documents contradict"
    },
    "procedural": {
      "type": "object",
      "properties": {
        "court_confirmed": {
          "type": "boolean"
        },
        "route_confirmed": {
          "type": "boolean"
        },
        "time_limit_confirmed": {
          "type": "boolean"
        }
      },
      "description": "Which procedural points the user has confirmed from the documents"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "affects": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "evidence_text": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "conflict": {
            "type": "string"
          },
          "conflict_detail": {
            "type": "string"
          },
          "conflict_resolution": {
            "type": "string"
          },
          "round": {
            "type": "number"
          }
        }
      },
      "description": "Preparation questions and the user's answers for this version"
    },
    "question_round": {
      "type": "number",
      "description": "How many question rounds have been run (initial plus follow-ups, maximum three)"
    },
    "prospects": {
      "type": "object",
      "properties": {
        "rating": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "assessment": {
          "type": "object"
        },
        "generated_at": {
          "type": "string"
        }
      },
      "description": "Checklist result, rating and AI assessment saved with this version"
    }
  },
  "required": [
    "matter_id",
    "argument_title",
    "position",
    "court"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}